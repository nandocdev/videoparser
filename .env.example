# --- Aplicación ---
APP_NAME="CallQA Server"
DEBUG=False
SECRET_KEY=

# --- Base de Datos ---
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/dbname
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=

# --- Almacenamiento ---
UPLOAD_DIRECTORY=uploads
CLIPS_OUTPUT_DIRECTORY=clips
TEMP_DIRECTORY=temp

# --- Integración CDR (Telephony) ---
CDR_API_URL=
CDR_API_TOKEN=
CDR_SYNC_DAYS_BACK=7

# --- Procesamiento de Video/Audio ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Parámetros de detección
AUDIO_SAMPLE_RATE=16000
SILENCE_THRESHOLD_DB=-40
MIN_CALL_DURATION=3
SILENCE_DURATION=2

# --- Worker ---
WORKER_CHECK_INTERVAL=30
MAX_CONCURRENT_TASKS=3

# --- Monitoreo y Logs ---
LOG_LEVEL=INFO
SENTRY_DSN=
